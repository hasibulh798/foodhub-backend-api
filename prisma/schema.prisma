generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model Provider_profile {
  id           String   @id @default(uuid())
  userId       String   @unique
  businessName String   @db.VarChar(255)
  address      String   @db.VarChar(255)
  isVerified   Boolean  @default(false)
  logoUrl      String?
  deliveryFee  Decimal  @default(60.00) @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  meals        Meal[]
  orders       Order[]
  user         User     @relation(fields: [userId], references: [id])

  @@map("provider_profiles")
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  iconUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meals     Meal[]

  @@map("categories")
}

model Meal {
  id          String           @id @default(uuid())
  providerId  String
  categoryId  String
  name        String           @db.VarChar(150)
  description String
  price       Decimal          @db.Decimal(10, 2)
  isAvailable Boolean          @default(true)
  imageUrl    String?
  cuisine     String?
  dietaryType DietaryType? 
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  category    Category         @relation(fields: [categoryId], references: [id])
  provider    Provider_profile @relation(fields: [providerId], references: [id])
  order_items Order_item[]
  reviews     Review[]

  @@index([providerId])
  @@map("meals")
}
enum DietaryType {
  VEG
  NON_VEG
  VEGAN
}
model Order {
  id              String           @id @default(uuid())
  customerId      String
  providerId      String
  phone           String
  subtotal        Decimal          @db.Decimal(10, 2)
  totalAmount     Decimal          @db.Decimal(10, 2)
  paymentMethod   PaymentMethod    
  paymentStatus   PaymentStatus    @default(PENDING)
  transactionId   String?          @unique
  status          OrderStatus      @default(PENDING)
  deliveryAddress String           @db.VarChar(255)
  deliveryFee     Decimal
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderItems      Order_item[]
  provider        Provider_profile @relation(fields: [providerId], references: [id])
  customer            User?            @relation(fields: [customerId], references: [id])
  reviews         Review[]

  @@index([customerId])
  @@map("orders")
}

enum PaymentMethod {
  COD
  ONLINE
}

model Order_item {
  id        String   @id @default(uuid())
  orderId   String
  mealId    String
  quantity  Int      @default(1)
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  meal      Meal     @relation(fields: [mealId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String
  customerId String
  mealId     String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  meal       Meal     @relation(fields: [mealId], references: [id])
  order      Order    @relation(fields: [orderId], references: [id])
  customer       User?    @relation(fields: [customerId], references: [id])

  @@unique([orderId, mealId])
  @@index([customerId])
  @@index([mealId])
  @@map("reviews")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model User {
  id               String            @id
  name             String
  email            String            @unique
  emailVerified    Boolean           @default(false)
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime
  role             UserRole          @default(CUSTOMER)
  phone            String?
  status           UserStatus?       @default(ACTIVE)
  accounts         Account[]
  orders           Order[]
  providerProfiles Provider_profile?
  reviews          Review[]
  sessions         Session[]

  @@map("users")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum UserRole {
  CUSTOMER
  PROVIDER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
